{
  "extends": [
    "@tsconfig/react-native/tsconfig.json",
    "../../config/tsconfig.json"
  ],
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "./",
    "paths": {
      "react-native-nitro-modules": ["../react-native-nitro-modules/lib/typescript/index.d.ts"],
      "react-native-nitro-modules/*": ["../react-native-nitro-modules/lib/typescript/*"]
    }
  }
}
